<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.QRAlarm" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#7C69FF</item>
        <item name="android:navigationBarColor">#0A0C11</item>
        <item name="android:statusBarColor">#0A0C11</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.QRAlarm.EditorSheet" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorAccent">#7C69FF</item>
        <item name="android:statusBarColor">#0A0C11</item>
        <item name="android:navigationBarColor">#0A0C11</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
